{% layout "base.liquid" %}
{% block title %}shantaram.xyz | Posts{% endblock %}

{% block content %}
<div class="post-heading-wrapper">
  <h1>Posts</h1>
  <div class="cta"><a href="/" class="muted">Back to home</a></div>
</div>

<p class="muted">
  Subscribe to the <a href="/blog/feed.rss">RSS feed</a> to stay updated on my
  latest posts.
</p>

<div class="tag-row tag-filter-buttons">
  {% for tag in tagLinks %}
  <a class="tag{% unless tag.selected %} outlined{% endunless %}" href="{{ tag.href }}">{{ tag.name | escape }}</a>
  {% endfor %}
</div>

{% for post in posts %}
{% render "post.partial.liquid" title: post.title url: post.url description: post.description tags: post.tags date: post.dateLabel %}
{% endfor %}

{% if posts.size == 0 %}
<p class="muted">No posts for this filter.</p>
{% endif %}

{% if pages > 1 %}
<nav class="pagination">
  {% if prevUrl %}<a href="{{ prevUrl }}">Previous</a>{% endif %}
  <span class="muted">Page {{ page }} of {{ pages }}</span>
  {% if nextUrl %}<a href="{{ nextUrl }}">Next</a>{% endif %}
</nav>
{% endif %}
{% endblock %}
